rules_version = '2';

// Requires approved UID mappings, a minimal member directory, and administrator-
// created duty assignments. Deploy together with the approved-mode website.
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedGoogleAccount() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '').size() > 0
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function validId(value) {
      return value is string && value.size() > 0 && value.size() <= 128
        && value.matches('^[^/]+$');
    }

    function access() {
      return get(/databases/$(database)/documents/member_access/$(request.auth.uid)).data;
    }

    function memberMatchesAccess(entry, uid) {
      let member = get(/databases/$(database)/documents/members/$(entry.student_id)).data;
      return member.Student_ID == entry.student_id
        && member.Google_UID == uid
        && member.Google_Email == entry.email
        && member.Role == entry.role
        && member.Status == 'Active';
    }

    function isMember() {
      return verifiedGoogleAccount()
        && exists(/databases/$(database)/documents/member_access/$(request.auth.uid))
        && callerMatchesAccess(access());
    }

    function callerMatchesAccess(entry) {
      return entry.role in ['User', 'Admin'] && validId(entry.student_id)
        && entry.email == request.auth.token.email
        && memberMatchesAccess(entry, request.auth.uid);
    }

    function isAdmin() {
      return isMember() && access().role == 'Admin';
    }

    function ownsMember(studentId) {
      return isMember() && access().student_id == studentId;
    }

    // Both directions must agree AFTER an atomic write. A UID cannot be assigned
    // to two members, including by an accidental administrator write.
    function validAccess(uid) {
      let data = request.resource.data;
      let member = getAfter(/databases/$(database)/documents/members/$(data.student_id)).data;
      return validId(uid) && validId(data.student_id)
        && data.keys().hasOnly(['student_id', 'email', 'role', 'approved_by', 'approved_at'])
        && data.keys().hasAll(['student_id', 'email', 'role', 'approved_by', 'approved_at'])
        && data.email is string && data.email.size() > 0 && data.email.size() <= 320
        && data.role in ['User', 'Admin']
        && data.approved_by == request.auth.uid
        && data.approved_at == request.time
        && member.Student_ID == data.student_id
        && member.Google_UID == uid && member.Google_Email == data.email
        && member.Role == data.role && member.Status == 'Active';
    }

    function previousMemberDetached(uid) {
      let oldId = resource.data.student_id;
      return !existsAfter(/databases/$(database)/documents/members/$(oldId))
        || getAfter(/databases/$(database)/documents/members/$(oldId)).data.get('Google_UID', '') != uid;
    }

    function linkedAccessAfter(member, memberId) {
      let uid = member.get('Google_UID', '');
      return (uid == null || uid == '')
        ? member.Role == 'User'
        : (validId(uid)
          && getAfter(/databases/$(database)/documents/member_access/$(uid)).data.student_id == memberId
          && getAfter(/databases/$(database)/documents/member_access/$(uid)).data.role == member.Role
          && getAfter(/databases/$(database)/documents/member_access/$(uid)).data.email == member.Google_Email);
    }

    function oldAccessDetached(memberId) {
      let uid = resource.data.get('Google_UID', '');
      return uid == null || uid == ''
        || !existsAfter(/databases/$(database)/documents/member_access/$(uid))
        || getAfter(/databases/$(database)/documents/member_access/$(uid)).data.student_id != memberId;
    }

    function validMemberWrite(memberId) {
      let data = request.resource.data;
      return validId(memberId) && data.Student_ID == memberId
        && data.Role in ['User', 'Admin'] && data.Status in ['Active', 'Alumni']
        && linkedAccessAfter(data, memberId);
    }

    function ownAuthorizationUnchanged() {
      return resource.data.get('Google_UID', '') != request.auth.uid
        || !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['Student_ID', 'Google_UID', 'Google_Email', 'Role', 'Status']);
    }

    function validOwnDisplayName() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Google_Display_Name'])
        && request.resource.data.Google_Display_Name is string
        && request.resource.data.Google_Display_Name.size() <= 120
        && request.resource.data.Google_Display_Name == request.auth.token.get('name', '');
    }

    // A deliberate, small projection: no Google identity, phone, account history,
    // private e-mail, administrative notes or future fields can leak into lists.
    function validDirectory(memberId) {
      let data = request.resource.data;
      let member = getAfter(/databases/$(database)/documents/members/$(memberId)).data;
      return data.keys().hasOnly(['Student_ID', 'Name_Ch', 'Name_En', 'Degree', 'Status', 'Role', 'Enrollment_Date'])
        && data.keys().hasAll(['Student_ID', 'Name_Ch', 'Name_En', 'Degree', 'Status', 'Role', 'Enrollment_Date'])
        && data.Student_ID == memberId && member.Student_ID == memberId
        && data.Name_Ch is string && data.Name_Ch == member.get('Name_Ch', '')
        && data.Name_En is string && data.Name_En == member.get('Name_En', '')
        && data.Degree is string && data.Degree == member.get('Degree', '')
        && data.Status == member.Status && data.Role == member.Role
        && data.Enrollment_Date is string && data.Enrollment_Date == member.get('Enrollment_Date', '');
    }

    function validJoinRequest() {
      let data = request.resource.data;
      return data.keys().hasOnly(['student_id', 'email', 'display_name', 'requested_at'])
        && data.keys().hasAll(['student_id', 'email', 'display_name', 'requested_at'])
        && validId(data.student_id)
        && data.email == request.auth.token.email
        && data.display_name is string && data.display_name.size() <= 120
        && data.display_name == request.auth.token.get('name', '')
        && data.requested_at == request.time;
    }

    function validInventoryUpdate(propId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return propId != '_SETTINGS_'
        && get(/databases/$(database)/documents/inventory/_SETTINGS_).data.IsOpen == true
        && access().student_id == data.Updated_By_Student_ID
        && data.Updated_By_UID == request.auth.uid
        && changed.hasOnly(['Status', 'Checked_By', 'Checked_By_Student_ID', 'Location',
          'Personal_Remark', 'Updated_By_UID', 'Updated_By_Student_ID', 'Updated_At'])
        && data.Updated_At is string && data.Updated_At.size() <= 40
        && data.Status in ['Pending', 'Checked']
        && data.get('Location', '') is string && data.get('Location', '').size() <= 100
        && data.get('Personal_Remark', '') is string && data.get('Personal_Remark', '').size() <= 500
        && (!changed.hasAny(['Status', 'Checked_By', 'Checked_By_Student_ID'])
          || (data.Status == 'Checked' && data.Checked_By == request.auth.uid
            && data.Checked_By_Student_ID == access().student_id)
          || (data.Status == 'Pending' && data.Checked_By == null && data.Checked_By_Student_ID == null));
    }

    function validWeek(week) {
      return week is string && week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Members cannot choose themselves as the assignee for arbitrary weeks.
    function approvedDutyAssignment(weekId, data) {
      let assignment = get(/databases/$(database)/documents/duty_assignments/$(weekId)).data;
      return assignment.assigned_to == data.assigned_to
        && assignment.scheduled_to == data.scheduled_to
        && assignment.assignment_source == data.assignment_source
        && assignment.get('carried_from', null) == data.get('carried_from', null);
    }

    function validDutyShape(weekId, data) {
      return validWeek(weekId) && data.week_start == weekId
        && data.keys().hasOnly(['week_start', 'scheduled_to', 'assigned_to', 'assignment_source',
          'status', 'carried_from', 'carried_over_to', 'carryover_count', 'substitute_pending',
          'substitute_from', 'cleaning', 'supplies', 'note', 'submitted', 'submitted_at',
          'created_by_uid', 'created_by_student_id', 'updated_at'])
        && data.keys().hasAll(['week_start', 'scheduled_to', 'assigned_to', 'assignment_source',
          'status', 'cleaning', 'supplies', 'note', 'submitted', 'created_by_uid'])
        && validId(data.assigned_to) && validId(data.scheduled_to)
        && data.assignment_source in ['auto', 'carryover', 'manual', 'substitute']
        && data.status in ['pending', 'submitted', 'carried_over']
        && data.submitted is bool
        && data.note is string && data.note.size() <= 1000
        && data.get('updated_at', '') is string && data.get('updated_at', '').size() <= 40
        && validChecklist(data)
        && (data.submitted == true
          ? (data.status == 'submitted' && data.submitted_at is string
            && data.submitted_at.size() <= 40 && completeChecklist(data))
          : data.status != 'submitted');
    }

    function validChecklist(data) {
      let cleaning = data.cleaning;
      let supplies = data.supplies;
      let statuses = [null, false, true, 'sufficient', 'needs_order', 'ordered'];
      return cleaning is map && supplies is map
        && cleaning.keys().hasOnly(['sweep', 'trash', 'supply_check', 'water', 'fingerprint'])
        && cleaning.get('sweep', false) is bool && cleaning.get('trash', false) is bool
        && cleaning.get('supply_check', false) is bool && cleaning.get('water', false) is bool
        && cleaning.get('fingerprint', false) is bool
        && supplies.keys().hasOnly(['acetone', 'methanol', 'detergent', 'n2_tank', 'wiper',
          'glass_slide', 'gloves_s', 'gloves_m', 'gloves_l', 'cotton_swab', 'aluminum_foil', 'pe_gloves'])
        && supplies.get('acetone', null) in statuses && supplies.get('methanol', null) in statuses
        && supplies.get('detergent', null) in statuses && supplies.get('n2_tank', null) in statuses
        && supplies.get('wiper', null) in statuses && supplies.get('glass_slide', null) in statuses
        && supplies.get('gloves_s', null) in statuses && supplies.get('gloves_m', null) in statuses
        && supplies.get('gloves_l', null) in statuses && supplies.get('cotton_swab', null) in statuses
        && supplies.get('aluminum_foil', null) in statuses && supplies.get('pe_gloves', null) in statuses;
    }

    function completeChecklist(data) {
      let c = data.cleaning;
      let s = data.supplies;
      let ready = ['sufficient', 'ordered', true];
      return c.get('sweep', false) == true && c.get('trash', false) == true
        && c.get('supply_check', false) == true && c.get('water', false) == true
        && c.get('fingerprint', false) == true
        && s.get('acetone', null) in ready && s.get('methanol', null) in ready
        && s.get('detergent', null) in ready && s.get('n2_tank', null) in ready
        && s.get('wiper', null) in ready && s.get('glass_slide', null) in ready
        && s.get('gloves_s', null) in ready && s.get('gloves_m', null) in ready
        && s.get('gloves_l', null) in ready && s.get('cotton_swab', null) in ready
        && s.get('aluminum_foil', null) in ready && s.get('pe_gloves', null) in ready;
    }

    function validCarryover() {
      let targetId = request.resource.data.carried_over_to;
      let target = getAfter(/databases/$(database)/documents/duty_records/$(targetId)).data;
      return validWeek(targetId) && targetId > resource.data.week_start
        && target.week_start == targetId && target.carried_from == resource.data.week_start
        && target.assigned_to == resource.data.assigned_to
        && target.assignment_source == 'carryover' && target.status == 'pending'
        && target.submitted == false;
    }

    function validAssigneeUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return access().student_id == resource.data.assigned_to
        && resource.data.status == 'pending' && resource.data.submitted == false
        && (changed.hasOnly(['cleaning', 'supplies', 'note', 'updated_at'])
          || (changed.hasOnly(['note', 'status', 'submitted', 'submitted_at', 'updated_at'])
            && data.status == 'submitted' && data.submitted == true)
          || (changed.hasOnly(['status', 'carried_over_to', 'updated_at'])
            && data.status == 'carried_over' && validCarryover()));
    }

    // Allow administrators to migrate references in historical records without
    // forcing old checklist formats to be rewritten or marking them completed.
    function validDutyReferenceUpdate() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys().hasOnly([
          'scheduled_to', 'assigned_to', 'substitute_pending', 'substitute_from'])
        && validId(data.assigned_to)
        && validId(data.get('scheduled_to', data.assigned_to))
        && (data.get('substitute_pending', null) == null || validId(data.substitute_pending))
        && (data.get('substitute_from', null) == null || validId(data.substitute_from));
    }

    match /member_access/{uid} {
      allow get: if verifiedGoogleAccount() && (uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && uid != request.auth.uid && validAccess(uid);
      allow update: if isAdmin() && uid != request.auth.uid && validAccess(uid)
        && (resource.data.student_id == request.resource.data.student_id || previousMemberDetached(uid));
      allow delete: if isAdmin() && uid != request.auth.uid && previousMemberDetached(uid);
    }

    // A join request is an assertion to review, never membership or an invitation.
    match /access_requests/{uid} {
      allow get: if verifiedGoogleAccount() && (uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if verifiedGoogleAccount() && uid == request.auth.uid
        && !exists(/databases/$(database)/documents/member_access/$(uid)) && validJoinRequest();
      allow delete: if isAdmin() || (verifiedGoogleAccount() && uid == request.auth.uid);
    }

    match /members/{memberId} {
      allow get: if isAdmin() || ownsMember(memberId);
      allow list: if isAdmin();
      allow create: if isAdmin() && validMemberWrite(memberId);
      allow update: if (isAdmin() && validMemberWrite(memberId) && ownAuthorizationUnchanged()
          && (resource.data.get('Google_UID', '') == request.resource.data.get('Google_UID', '')
            || oldAccessDetached(memberId)))
        || (ownsMember(memberId) && validOwnDisplayName());
      allow delete: if isAdmin() && resource.data.get('Google_UID', '') != request.auth.uid
        && oldAccessDetached(memberId)
        && !existsAfter(/databases/$(database)/documents/member_directory/$(memberId));
    }

    match /member_directory/{memberId} {
      allow read: if isMember();
      allow create, update: if isAdmin() && validDirectory(memberId);
      allow delete: if isAdmin();
    }

    // Legacy registry has no authority in this version and cannot grant access.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /instruments/{instrumentId} {
      allow read: if isMember();
      allow create, update, delete: if isAdmin();
    }

    match /logs/{logId} {
      allow read: if isMember();
      allow create, update, delete: if isAdmin();
    }

    match /inventory/{propId} {
      allow read: if isMember();
      allow create, delete: if isAdmin();
      allow update: if isMember() && (access().role == 'Admin' || validInventoryUpdate(propId));
    }

    match /duty_assignments/{weekId} {
      allow read: if isMember();
      allow create, update: if isAdmin() && validWeek(weekId)
        && request.resource.data.keys().hasOnly(['assigned_to', 'scheduled_to', 'assignment_source', 'carried_from'])
        && validId(request.resource.data.assigned_to) && validId(request.resource.data.scheduled_to)
        && request.resource.data.assignment_source in ['auto', 'carryover', 'manual', 'substitute'];
      allow delete: if isAdmin();
    }

    match /duty_records/{weekId} {
      allow read: if isMember();
      allow create: if isMember() && validDutyShape(weekId, request.resource.data)
        && request.resource.data.created_by_uid == request.auth.uid
        && request.resource.data.status == 'pending' && request.resource.data.submitted == false
        && (access().role == 'Admin' || (access().student_id == request.resource.data.assigned_to
          && request.resource.data.created_by_student_id == access().student_id
          && approvedDutyAssignment(weekId, request.resource.data)));
      allow update: if isMember()
        && ((access().role == 'Admin' && validDutyReferenceUpdate())
          || (validDutyShape(weekId, request.resource.data)
            && (access().role == 'Admin' || validAssigneeUpdate())));
      allow delete: if isAdmin();
    }

    match /bulletins/{bulletinId} {
      allow read: if isMember() && (isAdmin() || resource.data.published == true);
      allow create, update, delete: if isAdmin();
    }

    match /routines/{routineId} {
      allow read: if isMember() && (isAdmin() || resource.data.visible_to_users == true);
      allow create, update, delete: if isAdmin();
    }

    match /accounting/{transactionId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /projects/{projectId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /employments/{employmentId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /inventory_archive/{document=**} {
      allow read, create, update, delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
